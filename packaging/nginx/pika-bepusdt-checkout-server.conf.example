# Load this file only inside the Acg-Faka HTTPS server {} whose server_name is
# the exact merchant_origin. The host must also have a separate default reject
# server (see pika-bepusdt-default-reject.conf.example). Never include it in a
# generic BEpusdt proxy server. Replace __BEPUSDT_LOOPBACK_PORT__ first.
# V0.1 uses BEpusdt's fixed-payment official checkout and exposes only its
# buyer page, status lookup and static assets. It does not expose re-selection,
# order creation, notification or any BEpusdt administration route.

location ~ "^/pay/(?:checkout/[A-Za-z0-9]{18}|checkout-counter/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$" {
    limit_except GET { deny all; }
    limit_req zone=pika_bepusdt_checkout burst=20 nodelay;
    limit_conn pika_bepusdt_checkout_conn 4;
    client_max_body_size 1k;

    proxy_pass http://127.0.0.1:__BEPUSDT_LOOPBACK_PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_hide_header Set-Cookie;
    proxy_connect_timeout 3s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
    proxy_buffering on;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Cache-Control "no-store" always;
}

location = /api/v1/pay/info {
    limit_except POST { deny all; }
    limit_req zone=pika_bepusdt_checkout burst=20 nodelay;
    limit_conn pika_bepusdt_checkout_conn 4;
    client_max_body_size 16k;

    proxy_pass http://127.0.0.1:__BEPUSDT_LOOPBACK_PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_hide_header Set-Cookie;
    proxy_connect_timeout 3s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
    proxy_buffering on;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Cache-Control "no-store" always;
}

location ^~ /checkout/official/assets/ {
    limit_except GET { deny all; }
    limit_conn pika_bepusdt_checkout_conn 8;
    client_max_body_size 1k;

    proxy_pass http://127.0.0.1:__BEPUSDT_LOOPBACK_PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_hide_header Set-Cookie;
    proxy_connect_timeout 3s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Cache-Control "public, max-age=3600" always;
}

# Compatibility assets for BEpusdt releases that still return the documented
# checkout-counter UUID route. No admin or secure assets are exposed.
location ^~ /payment/assets/ {
    limit_except GET { deny all; }
    limit_conn pika_bepusdt_checkout_conn 8;
    client_max_body_size 1k;

    proxy_pass http://127.0.0.1:__BEPUSDT_LOOPBACK_PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_hide_header Set-Cookie;
    proxy_connect_timeout 3s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Cache-Control "public, max-age=3600" always;
}
